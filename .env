# The auth server. Read by next.config.mjs at build time as the rewrite target;
# never shipped to the browser.
PONTIVE_AUTH_HOST=idmatic-wqpdw11s.auth.us.pontive-dev.com

# What the SDK calls: a path on this app's own origin, which next.config.mjs
# rewrites onto PONTIVE_AUTH_HOST. Not a hostname — that is the point.
NEXT_PUBLIC_PONTIVE_AUTH_DOMAIN=/__auth

NEXT_PUBLIC_PONTIVE_APP_ID=app_06fgq637wsxt7610cfnxxthy08
NEXT_PUBLIC_PONTIVE_PROJECT_ID=proj_06fghx60hnrcxftadsj44e0pj8
NEXT_PUBLIC_PONTIVE_API_BASE_URL=https://api.pontive-dev.com
