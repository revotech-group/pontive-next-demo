# The auth server of the instance this app signs in against. Read by
# next.config.mjs at build time as the rewrite target; never shipped to the
# browser. A production instance is {project-slug}.auth.{region}.<root>; a
# non-production one is {project-slug}-{instance-slug}.auth.{region}.<root>
# (pontive.app / pontive.dev in production Pontive; pontive-dev.com for both in
# the dev deployment).
PONTIVE_AUTH_HOST=idmatic-tzkot2eo-dev.auth.us.pontive-dev.com

# What the SDK calls: a path on this app's own origin, which next.config.mjs
# rewrites onto PONTIVE_AUTH_HOST. Not a hostname — that is the point.
NEXT_PUBLIC_PONTIVE_AUTH_DOMAIN=/__auth
NEXT_PUBLIC_PONTIVE_INSTANCE_ID=inst_06gd4gxha1vwnetvr2519z9bj8
NEXT_PUBLIC_PONTIVE_APP_ID=app_06gd4gxha1vwnetvr2519z9bj8

# The management gateway. Called from the browser with the user's bearer token;
# the SDK adds /mgmt/v1 itself. Bearer-only, no cookies, so no proxy is needed.
NEXT_PUBLIC_PONTIVE_API_BASE_URL=https://api.us.pontive-dev.com
